---
layout: dasar.njk
---
{% set idProgres = page.fileSlug %}
{% set sebelum = collections.pelajaranUrut | getPreviousCollectionItem %}
{% set sesudah = collections.pelajaranUrut | getNextCollectionItem %}
<div class="bungkus-pelajaran">
  {% include "bagian/bilah-tab.njk" %}
  <div class="pelajaran">
    <article class="materi">
      <p class="nomor">Pelajaran {{ urutan }}{% if roadmap %} · Roadmap: {{ roadmap }}{% endif %}</p>
      <h1>{{ judul }}</h1>
      {{ content | safe }}
    </article>

    {% include "bagian/latihan.njk" %}
  </div>

  <nav class="langkah" aria-label="Pelajaran sebelum dan sesudah">
    {% if sebelum %}<a rel="prev" href="{{ sebelum.url | url }}">← {{ sebelum.data.judul }}</a>{% else %}<span></span>{% endif %}
    {% if sesudah %}<a rel="next" href="{{ sesudah.url | url }}">{{ sesudah.data.judul }} →</a>{% else %}<a href="{{ '/' | url }}#tantangan">Tantangan →</a>{% endif %}
  </nav>
</div>
